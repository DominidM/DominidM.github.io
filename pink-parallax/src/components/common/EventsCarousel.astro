---
const events = [
  {
    title: 'LEAD Builders',
    date: '2026',
    description: 'Un espacio exclusivo que reúne a estudiantes con alto potencial para enfrentar un reto claro: construir bajo presión',
    image: 'https://res.cloudinary.com/dxuk9bogw/image/upload/v1783798756/396eb0b9-c788-41f3-bd0c-0b681a1b8e60.png',
  },
    {
    title: 'Co-ordinador de PracticaYA - Dia del Practicante',
    date: '2026',
    description: 'Taller práctico sobre construcción de APIs GraphQL con Angular y Apollo Client.',
    image: 'https://res.cloudinary.com/dxuk9bogw/image/upload/v1783798705/7044d792-1b2e-45b1-a0e5-27f8bc7c5127.png',
  },
  {
    title: 'Hult Prize 2025',
    date: '2025',
    description: 'un espacio que reunió a estudiantes, aliados y profesionales comprometidos con la innovación social.',
    image: 'https://res.cloudinary.com/dxuk9bogw/image/upload/v1783798770/b18ef2a7-b13d-4e59-ab2a-588ec6cc3678.png',
  },

];
---

<div class="py-14 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-green-400 font-mono text-sm">$</span>
      <span class="text-gray-400 font-mono text-xs">ls events/ --format=card</span>
    </div>
    <div class="flex items-center gap-3 mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-white font-italiana">Eventos</h2>
      <div class="h-px flex-1 bg-gradient-to-r from-[#E95420]/50 to-transparent"></div>
    </div>

    <!-- Carousel container -->
    <div class="relative" id="events-root" data-events={JSON.stringify(events)}>
      <!-- Card -->
      <div class="bg-[#2C2C2C] rounded-xl border border-[#3D3D3D] overflow-hidden" id="events-card">
        <div class="grid sm:grid-cols-2 h-[300px] sm:h-[320px]">
          <div class="overflow-hidden bg-[#1A1A24]">
            <img id="events-img" src={events[0].image} alt="" class="w-full h-full object-cover transition-transform duration-500" loading="lazy" />
          </div>
          <div class="p-5 sm:p-6 flex flex-col justify-between overflow-y-auto">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-mono text-[#E95420] uppercase tracking-wider border border-[#E95420]/30 px-2 py-0.5 rounded-full">evento</span>
                <span id="events-date" class="text-xs font-mono text-yellow-400 flex-shrink-0 ml-2">{events[0].date}</span>
              </div>
              <h3 id="events-title" class="text-base sm:text-lg font-mono font-semibold text-white mb-3">{events[0].title}</h3>
              <p id="events-desc" class="text-xs sm:text-sm text-gray-400 leading-relaxed">{events[0].description}</p>
            </div>
            <div class="mt-4 flex items-center gap-2 text-gray-500 text-xs font-mono flex-shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
              <span id="events-counter">1 / {events.length}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div class="flex items-center justify-center gap-4 mt-5">
        <button id="events-prev" class="w-9 h-9 rounded-full bg-[#2C2C2C] border border-[#4D4D4D] hover:bg-[#373737] hover:border-[#E95420] text-gray-400 hover:text-white flex items-center justify-center transition-all text-lg" aria-label="Anterior">‹</button>

        <div class="flex gap-2" id="events-dots">
          {events.map((_, i) => (
            <button class={`w-2 h-2 rounded-full transition-all ${i === 0 ? 'bg-[#E95420] w-5' : 'bg-[#4D4D4D] hover:bg-[#6D6D6D]'}`} data-index={i} aria-label={`Evento ${i + 1}`}></button>
          ))}
        </div>

        <button id="events-next" class="w-9 h-9 rounded-full bg-[#2C2C2C] border border-[#4D4D4D] hover:bg-[#373737] hover:border-[#E95420] text-gray-400 hover:text-white flex items-center justify-center transition-all text-lg" aria-label="Siguiente">›</button>
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.getElementById('events-root');
  const events = JSON.parse(root?.getAttribute('data-events') ?? '[]');
  const img = document.getElementById('events-img');
  const title = document.getElementById('events-title');
  const desc = document.getElementById('events-desc');
  const date = document.getElementById('events-date');
  const counter = document.getElementById('events-counter');
  const dots = document.querySelectorAll('#events-dots button');
  const prev = document.getElementById('events-prev');
  const next = document.getElementById('events-next');

  let current = 0;

  const update = (index) => {
    const e = events[index];
    if (!e) return;
    if (img) img.src = e.image;
    if (title) title.textContent = e.title;
    if (desc) desc.textContent = e.description;
    if (date) date.textContent = e.date;
    if (counter) counter.textContent = `${index + 1} / ${events.length}`;
    dots.forEach((d, i) => {
      d.className = i === index
        ? 'w-5 h-2 rounded-full bg-[#E95420] transition-all'
        : 'w-2 h-2 rounded-full bg-[#4D4D4D] hover:bg-[#6D6D6D] transition-all';
    });
  };

  if (prev && next && events.length > 1) {
    prev.addEventListener('click', () => {
      current = (current - 1 + events.length) % events.length;
      update(current);
    });
    next.addEventListener('click', () => {
      current = (current + 1) % events.length;
      update(current);
    });
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        current = i;
        update(current);
      });
    });
  }
</script>
