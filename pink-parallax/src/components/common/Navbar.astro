---
const baseUrl = import.meta.env. BASE_URL;
const currentPath = Astro.url.pathname.replace(baseUrl, '/').replace(/\/$/, '') || '/';

const tabs = [
  { path: '/', label: 'index.tsx', icon: '●', color: 'orange' },
  { path: '/about', label:  'about.tsx', icon: '📄', color: 'blue' },
  { path:  '/projects', label: 'projects/', icon: '📁', color:  'purple' },
  { path: '/experience', label: 'experience.tsx', icon: '⚡', color: 'green' },
  { path:  '/desktop', label: 'desktop.tsx', icon: '🖥️', color: 'yellow' },
  { path: '/contact', label: 'contact. tsx', icon: '✉️', color: 'yellow' },
];

const getUrl = (path: string) => `${baseUrl}${path}`.replace(/\/\//g, '/');
---

<nav class="flex items-center bg-gray-900 px-4 overflow-x-auto">
  {tabs.map((tab) => {
    const isActive = currentPath === tab.path || (tab.path !== '/' && currentPath.startsWith(tab.path));
    
    return (
      <div class={`flex items-center border-r border-gray-600 px-4 py-3 min-w-max transition-colors ${isActive ? 'bg-gray-800' : 'hover:bg-gray-800'}`}>
        <span class={`text-sm mr-2 text-${tab.color}-400`}>{tab.icon}</span>
        <a 
          href={getUrl(tab.path)} 
          class={`text-sm font-mono transition-colors ${isActive ? 'text-white font-semibold' : 'text-gray-300 hover:text-white'}`}
        >
          {tab.label}
        </a>
      </div>
    );
  })}

  <!-- Espacio flexible -->
  <div class="flex-1"></div>

  <!-- Breadcrumb -->
  <div class="text-gray-400 text-xs font-mono px-4">
    ~/portfolio/src/pages/
  </div>
</nav>