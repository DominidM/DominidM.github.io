---
const baseUrl = import.meta.env.BASE_URL;
const currentPath = Astro. url.pathname.replace(baseUrl, '/').replace(/\/$/, '') || '/';

const tabs = [
  { path: '/', label: 'index.tsx', icon: '●', color: 'orange' },
  { path: '/about', label:  'about.tsx', icon: '📄', color: 'blue' },
  { path:  '/projects', label: 'projects/', icon: '📁', color: 'purple' },
  { path: '/experience', label:  'experience.tsx', icon: '⚡', color: 'green' },
  { path: '/desktop', label: 'desktop.tsx', icon: '🖥️', color: 'yellow' },
  { path:  '/contact', label: 'contact.tsx', icon: '✉️', color: 'yellow' },
];

const getUrl = (path: string) => `${baseUrl}${path}`.replace(/\/\//g, '/');
---

<nav class="flex items-center bg-gray-900 overflow-x-auto">
  {tabs.map((tab) => {
    const isActive = currentPath === tab.path || (tab. path !== '/' && currentPath. startsWith(tab.path));
    
    return (
      <a 
        href={getUrl(tab.path)} 
        class={`flex items-center border-r border-gray-600 px-4 py-3 min-w-max transition-colors no-underline ${isActive ? 'bg-gray-800' :  'hover:bg-gray-800'}`}
        style="display: flex; text-decoration: none;"
      >
        <span class={`text-sm mr-2 text-${tab.color}-400 pointer-events-none`}>{tab.icon}</span>
        <span class={`text-sm font-mono transition-colors pointer-events-none ${isActive ?  'text-white font-semibold' : 'text-gray-300 hover:text-white'}`}>
          {tab.label}
        </span>
      </a>
    );
  })}

  <!-- Espacio flexible -->
  <div class="flex-1"></div>

  <!-- Breadcrumb -->
  <div class="text-gray-400 text-xs font-mono px-4 py-3">
    ~/portfolio/src/pages/
  </div>
</nav>