<footer class="bg-[#1A1A24] border-t border-[#3D3D3D] mt-10">
  <!-- Ubuntu Terminal Title Bar -->
  <div class="bg-[#2C2C2C] border-b border-[#3D3D3D] px-3 md:px-4 py-1.5 flex items-center justify-between">
    <div class="flex items-center gap-1.5">
      <div class="w-3 h-3 md:w-3.5 md:h-3.5 rounded-full bg-[#E95420] flex items-center justify-center text-black text-[6px] md:text-[7px] font-bold opacity-80">✕</div>
      <div class="w-3 h-3 md:w-3.5 md:h-3.5 rounded-full bg-[#F5C211] flex items-center justify-center text-black text-[6px] md:text-[7px] font-bold opacity-80">−</div>
      <div class="w-3 h-3 md:w-3.5 md:h-3.5 rounded-full bg-[#0D942C] flex items-center justify-center text-black text-[6px] md:text-[7px] font-bold opacity-80">□</div>
    </div>

    <div class="text-gray-400 text-[10px] md:text-xs font-mono truncate mx-2 tracking-wide">
      dominid@portfolio: ~
    </div>

    <div class="flex items-center gap-2">
      <span class="text-[#E95420] text-[10px] font-mono">●</span>
      <span class="text-gray-600 text-[10px] font-mono hidden sm:block">bash</span>
    </div>
  </div>

  <!-- Terminal Body -->
  <div class="px-4 md:px-6 py-5 md:py-7 font-mono text-xs md:text-sm bg-[#1A1A24]">
    <div class="grid md:grid-cols-2 gap-5 md:gap-8 max-w-6xl mx-auto">

      <!-- Left: git status output -->
      <div class="space-y-2.5">
        <div class="flex items-center gap-2 text-[#E95420] text-xs">
          <span class="text-green-400">$</span>
          <span>git status</span>
        </div>

        <div class="text-gray-500 space-y-0.5 text-[11px] md:text-xs leading-relaxed pl-4 border-l-2 border-[#3D3D3D]">
          <div class="text-gray-400 hidden sm:block text-[10px]"># Please enter commit message...</div>
          <div># On branch <span class="text-red-400">main</span></div>
        </div>

        <div class="text-gray-500 space-y-0.5 text-[11px] md:text-xs pl-4 border-l-2 border-[#3D3D3D]">
          <div class="text-[#E95420] text-[10px]"># Changes to be committed:</div>
        </div>

        <div class="space-y-0.5 text-[11px] md:text-xs pl-4 border-l-2 border-[#3D3D3D]">
          <div class="text-gray-500">
            # <span class="text-green-400">modified:</span>
            <span class="text-gray-400"> src/components/TopBar.astro</span>
          </div>
          <div class="text-gray-500">
            # <span class="text-green-400">modified:</span>
            <span class="text-gray-400"> src/components/Navbar.astro</span>
          </div>
        </div>

        <div class="flex items-center gap-2 text-gray-400 text-xs border-t border-[#3D3D3D] pt-2 mt-3">
          <span class="text-green-400">$</span>
          <span class="text-gray-300">git commit -m "feat(ui): Ubuntu GNOME theme"</span>
          <span class="bg-[#E95420] w-2 h-5 animate-pulse ml-0.5"></span>
        </div>
      </div>

      <!-- Right: System info -->
      <div class="space-y-3 md:space-y-4">
        <div>
          <div class="flex items-center gap-2 text-[#E95420] text-xs mb-1.5">
            <span class="text-green-400">$</span>
            <span>cat /etc/os-release</span>
          </div>
          <div class="text-gray-400 space-y-0.5 text-[11px] md:text-xs pl-4 border-l-2 border-[#3D3D3D]">
            <div><span class="text-cyan-400">NAME</span>="Ubuntu"</div>
            <div><span class="text-cyan-400">VERSION</span>="24.04 LTS"</div>
            <div><span class="text-cyan-400">ID</span>=ubuntu</div>
          </div>
        </div>

        <div>
          <div class="flex items-center gap-2 text-[#E95420] text-xs mb-1.5">
            <span class="text-green-400">$</span>
            <span>whoami</span>
          </div>
          <div class="text-gray-300 text-[11px] md:text-xs pl-4 border-l-2 border-[#3D3D3D]">
            dominid
          </div>
        </div>

        <div class="border-t border-[#3D3D3D] pt-3 text-gray-600 text-[10px] md:text-xs mt-4">
          <div class="flex items-center gap-2">
            <span class="text-green-400">$</span>
            <span>© 2026 Dominid Muñoz — Built with Astro + TypeScript + Tailwind</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Ubuntu Status Bar -->
  <div class="bg-[#2C2C2C] border-t border-[#3D3D3D] px-3 md:px-4 py-1 flex items-center justify-between text-[10px] font-mono overflow-x-auto">
    <div class="flex items-center gap-3">
      <span class="bg-[#E95420] text-white px-1.5 py-0.5 font-bold text-[9px] rounded">NORMAL</span>
      <span class="text-green-400 text-[10px]">●</span>
      <span class="text-gray-500">main</span>
    </div>

    <div class="text-gray-600 text-[10px] hidden sm:block">
      UTF-8 · UNIX · ASTRO + TS
    </div>

    <div class="flex items-center gap-2 text-gray-600 text-[10px]">
      <span>LN 42, COL 18</span>
      <span class="w-px h-3 bg-[#4D4D4D]"></span>
      <span class="text-[#E95420]">⎔</span>
    </div>
  </div>
</footer>
