---
import "../styles/global.css";
import TopBar from "../components/common/TopBar.astro";
import Navbar from "../components/common/Navbar.astro";
import Footer from "../components/common/Footer.astro";

import { profile } from "../data/profile";

const CV_URL = profile.cvUrl;

const {
  title = 'Juan Dominid Muñoz | Desarrollador Backend | Java & Spring Boot',
  description = 'Portafolio de Juan Dominid Muñoz, Desarrollador Backend en Lima, Perú. Java, Spring Boot, NestJS, APIs REST, SQL, microservicios y sistemas ERP.',
  canonical = Astro.url.href,
  keywords = 'Backend Developer, Java Developer, Spring Boot, NestJS, Java, TypeScript, REST API, SQL, Microservices, Lima Peru',
} = Astro.props;

const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://dominidm.github.io';
const ogImage = `${siteOrigin}/D.ico`;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Activa el reveal solo si hay IntersectionObserver y el usuario no
         tiene reducción de movimiento. Si algo falla, nunca queda oculto. -->
    <script is:inline>
      (function () {
        try {
          if (!('IntersectionObserver' in window)) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          document.documentElement.classList.add('js-anim');
          // Failsafe: si reveal.js no inicializa en 2 s, se desactiva la
          // animación y todo el contenido queda visible.
          setTimeout(function () {
            if (!window.__revealReady) document.documentElement.classList.remove('js-anim');
          }, 2000);
        } catch (e) {}
      })();
    </script>

    <meta name="author" content="Juan Dominid Muñoz Eslava" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/D.ico" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Juan Dominid Muñoz — Portafolio" />
    <meta property="og:locale" content="es_PE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme -->
    <meta name="theme-color" content="#1A1A24" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{title}</title>

    <!-- JSON-LD Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Juan Dominid Muñoz Eslava',
      jobTitle: profile.roleEn,
      knowsAbout: ['Java', 'Spring Boot', 'NestJS', 'REST APIs', 'SQL', 'Microservices'],
      url: siteOrigin,
      email: profile.email,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Lima',
        addressCountry: 'PE',
      },
      sameAs: [
        profile.github,
        profile.linkedin,
        profile.company,
      ],
    })} />
  </head>
  <body class="bg-[#1A1A24] text-white h-screen flex flex-col overflow-hidden" style="font-family: 'Ubuntu', system-ui, sans-serif;">

    <a href="#main-content" class="sr-only-focusable">Saltar al contenido principal</a>

    <TopBar />

    <div class="flex flex-col md:flex-row flex-1 min-h-0">
      <Navbar cvUrl={CV_URL} />

      <main id="main-content" class="flex-1 min-w-0 overflow-y-auto">
        <slot />
        <Footer />
      </main>
    </div>

  </body>
</html>

<script>
  // Un único observer para todo el sitio (ver src/scripts/reveal.js).
  import "../scripts/reveal.js";
</script>
