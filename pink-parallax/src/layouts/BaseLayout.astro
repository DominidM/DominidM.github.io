---
import "../styles/global.css";
import TopBar from "../components/common/TopBar.astro";
import Navbar from "../components/common/Navbar.astro";
import Footer from "../components/common/Footer.astro";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/D.ico" />
    <title>Dominid Muñoz | Systems Engineer | Portfolio</title>
  </head>
  <body class="bg-[#1A1A24] text-white h-screen flex flex-col overflow-hidden" style="font-family: 'Ubuntu', system-ui, sans-serif;">

    <TopBar />

    <div class="flex flex-col md:flex-row flex-1 min-h-0">
      <Navbar />

      <main class="flex-1 min-w-0 overflow-y-auto">
        <slot />
        <Footer />
      </main>
    </div>

  </body>
</html>
