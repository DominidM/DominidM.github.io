---
import Layout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const stackGroups = [
  { label: 'Backend', items: ['Java', 'Spring Boot', 'NestJS', 'TypeScript', 'APIs REST', 'JWT', 'RBAC', 'WebSockets'], primary: true },
  { label: 'Bases de datos', items: ['MySQL', 'PostgreSQL', 'SQL Server', 'MongoDB'], primary: true },
  { label: 'Arquitectura', items: ['Microservicios', 'Arquitectura Hexagonal'], primary: true },
  { label: 'Herramientas', items: ['Git', 'Docker'], primary: true },
  { label: 'Complementarias', items: ['Angular', 'React', 'Next.js', 'Azure', 'Cloudflare', 'Firebase', 'Python'], primary: false },
];
---

<Layout
  title="Sobre mí | Juan Dominid Muñoz — Desarrollador Backend"
  description="Conoce a Juan Dominid Muñoz, estudiante de Ingeniería de Sistemas Computacionales y Desarrollador Backend enfocado en Java, Spring Boot y NestJS."
>
  <div class="text-center mb-8 sm:mb-3 pt-12">
    <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold text-white mb-2 font-italiana">
      Sobre Mí
    </h1>
  </div>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16 text-gray-300">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-12 items-start">

      <div class="space-y-6">
        <div class="relative bg-gray-900 rounded-2xl p-2 border border-gray-700">
          <img
            src="https://res.cloudinary.com/dxuk9bogw/image/upload/v1778605124/Gemini_Generated_Image_i5ibivi5ibivi5ib_1_jymszj.png"
            alt="Retrato de Juan Dominid Muñoz Eslava"
            class="w-full object-contain rounded-xl"
            width="600"
            height="400"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute bottom-4 left-4 right-4 bg-black/80 backdrop-blur rounded-lg p-3">
            <div class="flex items-center space-x-3">
              <div class="w-3 h-3 bg-green-400 rounded-full animate-pulse" aria-hidden="true"></div>
              <span class="text-white font-medium text-sm">Disposición inmediata</span>
            </div>
          </div>
        </div>

        <!-- Datos clave -->
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-gray-800 rounded-xl p-5 border border-gray-700">
            <div class="text-2xl font-bold text-[#E95420]">{profile.cycle}</div>
            <div class="text-gray-400 text-sm">Estudiante</div>
            <div class="text-gray-500 text-xs mt-1">{profile.career}</div>
          </div>
          <div class="bg-gray-800 rounded-xl p-5 border border-gray-700">
            <div class="text-2xl font-bold text-blue-400">Backend</div>
            <div class="text-gray-400 text-sm">Enfoque</div>
            <div class="text-gray-500 text-xs mt-1">Java · Spring Boot · NestJS</div>
          </div>
        </div>

        <!-- Contacto -->
        <div class="bg-gray-800 rounded-xl p-5 border border-gray-700 space-y-2">
          <h2 class="text-white font-semibold mb-3">Contacto</h2>
          <div class="flex items-center gap-2 text-sm">
            <span class="text-gray-400" aria-hidden="true">📧</span>
            <a href={`mailto:${profile.email}`} class="text-blue-400 hover:underline">
              {profile.email}
            </a>
          </div>
          <div class="flex items-center gap-2 text-sm">
            <span class="text-gray-400" aria-hidden="true">📱</span>
            <span class="text-gray-300">{profile.phone}</span>
          </div>
        </div>

        <a
          href={profile.cvUrl}
          download={profile.cvFile}
          class="block w-full text-center px-5 py-3 rounded-lg bg-[#E95420] hover:bg-[#E95420]/90 text-white text-sm font-mono font-medium transition-all hover:scale-105"
        >
          ↓ Descargar CV
        </a>
      </div>

      <!-- Texto -->
      <div class="space-y-8">
        <div class="text-lg leading-relaxed">
          Soy <span class="text-white font-semibold">{profile.fullName}</span>,
          estudiante de {profile.career} y desarrollador enfocado en
          <span class="text-white font-semibold">Backend</span>.
          Trabajo principalmente con Java, Spring Boot, NestJS y bases de datos relacionales.
        </div>

        <div class="text-gray-400 leading-relaxed">
          He participado en el desarrollo de sistemas ERP, aplicaciones empresariales y
          plataformas web, implementando <b class="text-white">APIs REST</b>,
          <b class="text-white">autenticación</b>, <b class="text-white">WebSockets</b>
          y arquitecturas basadas en microservicios.
        </div>

        <div class="text-gray-400 leading-relaxed">
          Formo parte de <span class="text-white font-semibold">Solvegrades Technology</span>
          como desarrollador backend y cofundador. Actualmente busco continuar
          fortaleciendo mi experiencia profesional en desarrollo Backend.
        </div>

        <!-- Qué busco -->
        <div class="bg-gray-800 rounded-xl p-5 border border-gray-700 space-y-3">
          <h2 class="text-white font-semibold">Qué busco</h2>
          <ul class="space-y-2 text-sm text-gray-400">
            <li class="flex items-start gap-2">
              <span class="text-[#E95420] mt-0.5" aria-hidden="true">→</span>
              Prácticas o posiciones Junior de desarrollo Backend
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#E95420] mt-0.5" aria-hidden="true">→</span>
              Trabajar con Java / Spring Boot y NestJS en sistemas reales
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#E95420] mt-0.5" aria-hidden="true">→</span>
              Seguir aprendiendo de bases de datos y arquitectura de software
            </li>
          </ul>
        </div>

        <div>
          <h2 class="text-xl font-bold text-white mb-4">Stack Tecnológico</h2>

          <div class="space-y-4">
            {stackGroups.map((group) => (
              <div>
                <p class={`text-sm mb-2 font-mono ${group.primary ? 'text-[#E95420]' : 'text-gray-400'}`}>
                  {group.label}
                </p>
                <div class="flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <span
                      class={
                        group.primary
                          ? 'bg-gray-800 px-3 py-2 rounded-lg text-sm border border-gray-700 text-gray-200'
                          : 'px-2.5 py-1.5 rounded-lg text-xs border border-gray-700 text-gray-400'
                      }
                    >
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="border-l-4 border-[#E95420] pl-4 text-gray-400">
          Actualmente estoy interesado en oportunidades de prácticas y posiciones Junior
          relacionadas con desarrollo Backend.
        </div>
      </div>
    </div>
  </section>
</Layout>
