---
import BaseLayout from "../layouts/BaseLayout.astro";

const contactJson = `
{
  "role": "Ingeneer Systems",
  "company": "SolveGrades",
  "co_founder": true,
  "focus": ["Web Development", "IoT"],
  "availability": "open_for_projects",
  "email": "dominidzero@gmail.com",
  "location": "Perú"
}
`;
---
<BaseLayout>
  <section class="max-w-6xl mx-auto px-6 py-12 font-mono">

    <!-- Header -->
    <div class="mb-8 border-b border-gray-700 pb-4">
      <h1 class="text-2xl text-green-400">contact.ts</h1>
      <p class="text-gray-400 text-sm">Información de contacto y perfil profesional</p>
    </div>

    <div class="grid md:grid-cols-2 gap-10">

      <!-- Terminal -->
      <div class="bg-black border border-gray-700 rounded-lg p-6 text-sm">

        <div class="flex items-center mb-4">
          <div class="w-3 h-3 rounded-full bg-[#E95420] flex items-center justify-center text-black text-[6px] font-bold mr-1.5 opacity-80">✕</div>
          <div class="w-3 h-3 rounded-full bg-[#F5C211] flex items-center justify-center text-black text-[6px] font-bold mr-1.5 opacity-80">−</div>
          <div class="w-3 h-3 rounded-full bg-[#0D942C] flex items-center justify-center text-black text-[6px] font-bold mr-1.5 opacity-80">□</div>
          <span class="ml-3 text-gray-400">terminal</span>
        </div>

        <div class="space-y-2 text-gray-300">

          <div>
            <span class="text-green-400">dominid@portfolio</span>:<span class="text-blue-400">~</span>$ whoami
          </div>
          <div class="pl-4 text-white">
            Juan Dominid Muñoz Eslava | Co-founder de SolveGrades
          </div>

          <div class="mt-3">
            <span class="text-green-400">dominid@portfolio</span>:<span class="text-blue-400">~</span>$ cat profile.json
          </div>

          <pre class="pl-4 text-gray-300 whitespace-pre-wrap">{contactJson}</pre>

          <div class="mt-3">
            <span class="text-green-400">dominid@portfolio</span>:<span class="text-blue-400">~</span>$ _
          </div>

        </div>

      </div>

      <!-- Right column -->
      <div class="space-y-8">

        <!-- Startup -->
        <div class="bg-gray-900 border border-gray-700 rounded-lg p-6">
          <h3 class="text-pink-400 mb-2"># Startup</h3>
          <p class="text-gray-300 text-sm leading-relaxed">
            <span class="text-white font-semibold">SolveGrades</span> es una iniciativa orientada al desarrollo de
            soluciones tecnológicas modernas, con enfoque en
            <span class="text-white">plataformas web</span> y
            <span class="text-white">sistemas IoT</span>.
            Participo como <span class="text-pink-400 font-semibold">cofundador</span> y arquitecto de soluciones.
          </p>

          <div class="mt-4 text-green-400 text-sm">
            Estado: disponible para nuevos proyectos
          </div>
        </div>

        <!-- Contact links -->
        <div>
          <h3 class="text-yellow-400 mb-2"># Canales principales</h3>

          <div class="space-y-3">

            <a href="mailto:dominidzero@gmail.com"
              class="block bg-gray-800 hover:bg-gray-700 transition border border-gray-700 rounded-lg p-4">
              <div class="text-white">Email</div>
              <div class="text-gray-400 text-sm">dominidzero@gmail.com</div>
            </a>

            <a href="https://github.com/DominidM" target="_blank"
              class="block bg-gray-800 hover:bg-gray-700 transition border border-gray-700 rounded-lg p-4">
              <div class="text-white">GitHub</div>
              <div class="text-gray-400 text-sm">github.com/DominidM</div>
            </a>

            <a href="https://linkedin.com/in/dominid-muñoz-eslava-50b68828a/" target="_blank"
              class="block bg-gray-800 hover:bg-gray-700 transition border border-gray-700 rounded-lg p-4">
              <div class="text-white">LinkedIn</div>
              <div class="text-gray-400 text-sm">
                linkedin.com/in/dominid-muñoz-eslava-50b68828a/
              </div>
            </a>

          </div>
        </div>

        <div class="border-l-4 border-green-500 pl-4 text-gray-400 text-sm italic">
          Para propuestas profesionales, colaboraciones técnicas o desarrollo de sistemas, el contacto debe realizarse
          preferentemente por correo o LinkedIn.
        </div>

      </div>

    </div>

    <div class="mt-12 pt-6 border-t border-gray-800 text-gray-500 text-xs">
      // Perfil activo · SolveGrades · Tiempo de respuesta promedio: 24–48h
    </div>

  </section>
</BaseLayout>
