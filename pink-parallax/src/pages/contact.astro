---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const profileJson = `{
  "role": "${profile.roleEn}",
  "company": "Solvegrades Technology",
  "cofounder": true,
  "focus": ["Java / Spring Boot", "NestJS", "Backend Systems"],
  "availability": "open_for_junior_backend_roles",
  "email": "${profile.email}",
  "location": "Lima, Perú"
}`;
---
<BaseLayout
  title="Contacto | Juan Dominid Muñoz — Desarrollador Backend"
  description="Información de contacto de Juan Dominid Muñoz, Desarrollador Backend en Lima, Perú. Java, Spring Boot y NestJS."
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 font-mono">

    <!-- Header -->
    <div class="mb-8 border-b border-gray-700 pb-4" data-reveal>
      <h1 class="text-2xl text-green-400">contact.ts</h1>
      <p class="text-gray-400 text-sm">Información de contacto y perfil profesional</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 lg:gap-10">

      <!-- Terminal -->
      <div class="bg-black border border-gray-700 rounded-lg p-4 sm:p-6 text-sm" data-reveal style="--reveal-delay: 60ms">

        <div class="flex items-center mb-4" aria-hidden="true">
          <div class="w-3 h-3 rounded-full bg-[#E95420] mr-1.5 opacity-80"></div>
          <div class="w-3 h-3 rounded-full bg-[#F5C211] mr-1.5 opacity-80"></div>
          <div class="w-3 h-3 rounded-full bg-[#0D942C] mr-1.5 opacity-80"></div>
          <span class="ml-3 text-gray-400">terminal</span>
        </div>

        <div class="space-y-2 text-gray-300">

          <div>
            <span class="text-green-400">dominid@portfolio</span>:<span class="text-blue-400">~</span>$ whoami
          </div>
          <div class="pl-4 text-white">
            Juan Dominid Muñoz Eslava | Backend Developer
          </div>

          <div class="mt-3">
            <span class="text-green-400">dominid@portfolio</span>:<span class="text-blue-400">~</span>$ cat profile.json
          </div>

          <pre class="pl-4 text-gray-300 whitespace-pre-wrap overflow-x-auto">{profileJson}</pre>

          <div class="mt-3">
            <span class="text-green-400">dominid@portfolio</span>:<span class="text-blue-400">~</span>$ <span class="bg-[#E95420] w-2 h-5 inline-block animate-pulse"></span>
          </div>

        </div>

      </div>

      <!-- Right column -->
      <div class="space-y-8" data-reveal style="--reveal-delay: 130ms">

        <!-- Disponibilidad -->
        <div class="bg-gray-900 border border-gray-700 rounded-lg p-5 sm:p-6">
          <h2 class="text-pink-400 mb-2"># Disponibilidad</h2>
          <p class="text-gray-300 text-sm leading-relaxed">
            Actualmente estoy interesado en oportunidades de
            <span class="text-white">prácticas</span> y posiciones
            <span class="text-white">Junior</span> relacionadas con
            <span class="text-white">desarrollo Backend</span>.
          </p>

          <div class="mt-4 text-green-400 text-sm">
            Estado: abierto a oportunidades backend
          </div>
        </div>

        <!-- Contact links -->
        <div>
          <h2 class="text-yellow-400 mb-2"># Canales principales</h2>

          <div class="space-y-3">

            <a href={`mailto:${profile.email}`}
              class="block bg-gray-800 hover:bg-gray-700 transition border border-gray-700 rounded-lg p-4">
              <div class="text-white">Email</div>
              <div class="text-gray-400 text-sm break-all">{profile.email}</div>
            </a>

            <a href={profile.linkedin} target="_blank" rel="noopener noreferrer"
              class="block bg-gray-800 hover:bg-gray-700 transition border border-gray-700 rounded-lg p-4">
              <div class="text-white">LinkedIn</div>
              <div class="text-gray-400 text-sm break-all">
                linkedin.com/in/dominid-muñoz-eslava-50b68828a/
              </div>
            </a>

            <a href={profile.github} target="_blank" rel="noopener noreferrer"
              class="block bg-gray-800 hover:bg-gray-700 transition border border-gray-700 rounded-lg p-4">
              <div class="text-white">GitHub</div>
              <div class="text-gray-400 text-sm break-all">github.com/DominidM</div>
            </a>

          </div>
        </div>

        <!-- CV -->
        <div>
          <h2 class="text-yellow-400 mb-2"># CV</h2>
          <a
            href={profile.cvUrl}
            download={profile.cvFile}
            class="block w-full text-center px-5 py-3 rounded-lg bg-[#E95420] hover:bg-[#E95420]/90 text-white text-sm font-medium transition-all hover:scale-105"
          >
            ↓ Descargar CV
          </a>
        </div>

        <div class="border-l-4 border-green-500 pl-4 text-gray-400 text-sm italic">
          Para propuestas de prácticas o posiciones Junior, el contacto debe realizarse
          preferentemente por correo o LinkedIn.
        </div>

      </div>

    </div>

    <div class="mt-12 pt-6 border-t border-gray-800 text-gray-400 text-xs">
      // Perfil activo · {profile.role} · {profile.location}
    </div>

  </section>
</BaseLayout>
