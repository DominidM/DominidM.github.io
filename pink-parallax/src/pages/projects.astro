      'https://res.cloudinary.com/dxuk9bogw/image/upload/v1767845356/Captura_de_pantalla_2026-01-07_225504_ly20xt.png',
      'https://res.cloudinary.com/dxuk9bogw/image/upload/v1767845353/Captura_de_pantalla_2026-01-07_225057_vihv9o.png',
      'https://res.cloudinary.com/dxuk9bogw/image/upload/v1767845350/Captura_de_pantalla_2026-01-07_224923_humx6o.png',
      'https://res.cloudinary.com/dxuk9bogw/image/upload/v1767845349/Captura_de_pantalla_2026-01-07_224720_f16r23.png',
    ]
  },
  {
    id: 5,
    name: 'E-commerce Gasfitería',
    file: 'Gasfiteria.exe',
    color: 'cyan',
    client: 'Representaciones W.H.C.',
    ruc: '10076215851',
    date: 'Junio 2025',
    description: 'Tienda online completa para venta de productos de gasfitería. Incluye diseño UI/UX personalizado, APIs REST con operaciones CRUD completas y modelo de datos optimizado en PostgreSQL. Desplegado en Azure.',
    technologies: ['React', 'Vite', 'Spring Boot', 'Java', 'PostgreSQL', 'Azure'],
