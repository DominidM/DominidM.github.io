                      ? 'bg-gray-700 border-gray-400 text-white'
                      : 'bg-gray-900 border-gray-600 text-gray-400 hover:border-gray-400 hover:text-white'
                    }`}
                  data-filter={cat}
                >
                  {label}
                  <span class="ml-1.5 text-gray-500 text-xs font-mono">
                    ({counts[cat] ?? 0})
                  </span>
                </button>
              ))}
            </div>
            <!-- Línea separadora -->
