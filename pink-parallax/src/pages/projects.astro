const getTechColor = (tech: string): string => {
  const t = tech.toLowerCase();
  if (t.includes('angular') || t.includes('raspberry') || t.includes('thymeleaf') || t.includes('javamail')) return 'red';
  if (t.includes('spring') || t.includes('node') || t.includes('mongodb') || t.includes('django') || t.includes('iot')) return 'green';
  if (t.includes('api') || t.includes('mysql') || t.includes('azure') || t.includes('postgresql') || t.includes('ddd') || t.includes('websockets') || t.includes('docker')) return 'blue';
  if (t.includes('react') || t.includes('apollo') || t.includes('nestjs') || t.includes('next')) return 'cyan';
  if (t.includes('vite') || t.includes('nlp') || t.includes('primeng') || t.includes('typescript') || t.includes('cloudinary')) return 'purple';
  if (t.includes('java') && !t.includes('javascript') && !t.includes('javamail')) return 'orange';
  if (t.includes('express')) return 'gray';
  if (t.includes('graphql') || t.includes('ia') || t.includes('whatsapp')) return 'pink';
  if (t.includes('python')) return 'yellow';
  return 'gray';
};

