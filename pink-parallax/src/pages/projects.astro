    ]
  },
  {
    id: 6,
    name: 'Codop AdminPanel',
    file: 'Codop.exe',
    color: 'orange',
    client: 'Codop',
    company: 'Desarrollo Freelance',
    date: 'Junio - Agosto 2024',
