    technologies: ['Spring Boot', 'Thymeleaf', 'Java', 'Azure', 'JavaMailSender'],
    links: {
      githubBackend: 'https://github.com/DominidM/Policlinico-Autovias-Seguras',
      live: 'www.autoviasseguras.com'
    },
    images: [
      'https://res.cloudinary.com/dxuk9bogw/image/upload/v1767837804/Captura_de_pantalla_2026-01-07_205758_cdue5u.png',
      'https://res.cloudinary.com/dxuk9bogw/image/upload/v1767837804/Captura_de_pantalla_2026-01-07_205731_wssgu9.png',
      'https://res.cloudinary.com/dxuk9bogw/image/upload/v1767837804/Captura_de_pantalla_2026-01-07_210127_hnepfm.png',
