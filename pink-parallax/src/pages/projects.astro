<!-- ══ MODAL VIDEO DEMO ══════════════════════════════════════════════════════ -->
<div id="demo-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4">
  <div class="bg-gray-800 rounded-2xl border border-gray-600 w-full max-w-4xl">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-700">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 bg-purple-400 rounded-full animate-pulse"></span>
        <span id="demo-modal-title" class="text-white font-mono text-sm sm:text-base font-semibold"></span>
      </div>
      <button id="demo-modal-close" class="text-gray-400 hover:text-white transition-colors text-2xl leading-none">&times;</button>
    </div>
    <div class="p-4 sm:p-6">
      <video id="demo-video" controls class="w-full rounded-xl bg-black" style="max-height: 65vh;">
        <source id="demo-video-src" src="" type="video/mp4" />
        Tu navegador no soporta el elemento de video.
      </video>
    </div>
  </div>
</div>

<script>
  // ── Carousels académicos ───────────────────────────────────────
document.querySelectorAll('[id^="ac-carousel-"]').forEach(carousel => {
  const id = carousel.id;
  let currentIndex = 0;
  const slides = carousel.children.length;
  if (slides <= 1) return;

  const dots    = document.querySelectorAll(`[data-ac-dot="${id}"]`);
  const prevBtn = document.querySelector(`[data-ac-carousel="${id}"].ac-carousel-prev`);
  const nextBtn = document.querySelector(`[data-ac-carousel="${id}"].ac-carousel-next`);

  const update = () => {
    (carousel as HTMLElement).style.transform = `translateX(-${currentIndex * 100}%)`;
    dots.forEach((d, i) => {
      d.classList.toggle('bg-white', i === currentIndex);
      d.classList.toggle('bg-white/40', i !== currentIndex);
    });
  };

  nextBtn?.addEventListener('click', () => { currentIndex = (currentIndex + 1) % slides; update(); });
  prevBtn?.addEventListener('click', () => { currentIndex = (currentIndex - 1 + slides) % slides; update(); });
});
  document.addEventListener('DOMContentLoaded', () => {

    // ── Carousels ──────────────────────────────────────────────────────
    document.querySelectorAll('[id^="carousel-"]').forEach(carousel => {
      const id     = carousel.id;
      let currentIndex = 0;
      const slides = carousel.children.length;
      if (slides <= 1) return;
      const prevBtn = document.querySelector(`[data-carousel="${id}"].carousel-btn-prev`);
      const nextBtn = document.querySelector(`[data-carousel="${id}"].carousel-btn-next`);
      const update  = () => { (carousel as HTMLElement).style.transform = `translateX(-${currentIndex * 100}%)`; };
      nextBtn?.addEventListener('click', () => { currentIndex = (currentIndex + 1) % slides; update(); });
      prevBtn?.addEventListener('click', () => { currentIndex = (currentIndex - 1 + slides) % slides; update(); });
    });

    // ── Modal demo ─────────────────────────────────────────────────────
    const modal      = document.getElementById('demo-modal')!;
    const video      = document.getElementById('demo-video') as HTMLVideoElement;
    const videoSrc   = document.getElementById('demo-video-src') as HTMLSourceElement;
    const modalTitle = document.getElementById('demo-modal-title')!;
    const closeBtn   = document.getElementById('demo-modal-close')!;

    const openModal  = (src: string, title: string) => {
      videoSrc.src = src; video.load(); modalTitle.textContent = title;
      modal.classList.remove('hidden'); modal.classList.add('flex');
    };
    const closeModal = () => {
      video.pause(); videoSrc.src = '';
      modal.classList.add('hidden'); modal.classList.remove('flex');
    };

    document.querySelectorAll<HTMLButtonElement>('.demo-btn').forEach(btn =>
      btn.addEventListener('click', () => openModal(btn.dataset.demo ?? '', btn.dataset.demoTitle ?? 'Demo'))
    );
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    // ── Filtros ────────────────────────────────────────────────────────
    const filterTabs     = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const projectCards   = document.querySelectorAll<HTMLElement>('.project-card');
    const noResults      = document.getElementById('no-results')!;
    const academicSection = document.getElementById('academic-section')!;

    const ACTIVE_CLASSES   = ['bg-gray-700', 'border-gray-400', 'text-white'];
    const INACTIVE_CLASSES = ['bg-gray-900', 'border-gray-600', 'text-gray-400'];

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {

        // Actualizar estilos de tabs
        filterTabs.forEach(t => {
          t.classList.remove(...ACTIVE_CLASSES);
          t.classList.add(...INACTIVE_CLASSES);
        });
        tab.classList.remove(...INACTIVE_CLASSES);
        tab.classList.add(...ACTIVE_CLASSES);

        const cat = tab.dataset.filter ?? 'all';

        // Mostrar / ocultar proyectos profesionales
        let visible = 0;
        projectCards.forEach(card => {
          const match = cat === 'all' || card.dataset.category === cat;
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });

        // Mensaje sin resultados
        noResults.classList.toggle('hidden', visible > 0);

        // La sección académica se muestra siempre en "all", se oculta en filtros específicos
        academicSection.style.display = cat === 'all' ? '' : 'none';
      });
    });
  });
</script>