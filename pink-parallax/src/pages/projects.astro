const categories = ['all', 'erp', 'ecommerce', 'plataforma', 'web', 'otros'] as const;

const counts: Record<string, number> = { all: projects.length };
for (const p of projects) {
  counts[p.category] = (counts[p.category] ?? 0) + 1;
}

const colorMap: Record<string, { dot: string; border: string; text: string }> = {
  purple: { dot: 'bg-purple-400', border: 'border-purple-400', text: 'text-purple-400' },
  green:  { dot: 'bg-green-400',  border: 'border-green-400',  text: 'text-green-400'  },
  blue:   { dot: 'bg-blue-400',   border: 'border-blue-400',   text: 'text-blue-400'   },
  cyan:   { dot: 'bg-cyan-400',   border: 'border-cyan-400',   text: 'text-cyan-400'   },
  orange: { dot: 'bg-orange-400', border: 'border-orange-400', text: 'text-orange-400' },
  red:    { dot: 'bg-red-400',    border: 'border-red-400',    text: 'text-red-400'    },
};

const techBg = 'bg-gray-900 border border-gray-600 hover:border-gray-400';

const filterLabels: Record<string, string> = {
  all: 'all', erp: 'ERP', ecommerce: 'e-commerce', plataforma: 'plataforma', web: 'web', otros: 'otros',
};

const btn = 'bg-gray-900 hover:bg-gray-700 border border-gray-500 hover:border-gray-300 text-white px-4 sm:px-6 py-2 rounded-lg font-mono transition-all text-center text-sm sm:text-base inline-flex items-center justify-center gap-2';

const githubSvg = `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`;

// Índice del primer proyecto que pertenece a "otros proyectos".
const othersStartIndex = 4;
---

<BaseLayout
  title="Proyectos | Juan Dominid Muñoz — Desarrollador Backend"
  description="Proyectos de Juan Dominid Muñoz como Desarrollador Backend: sistemas ERP con NestJS, e-commerce con Spring Boot, APIs REST, WebSockets y microservicios."
>
  <main class="flex-grow w-full">
    <div class="bg-[#1A1A24] min-h-screen pt-4 sm:pt-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">

        <!-- Terminal Header -->
        <div class="bg-[#2C2C2C] rounded-t-xl border border-[#3D3D3D] shadow-lg shadow-black/20">
          <div class="flex items-center justify-between px-4 sm:px-5 py-2 sm:py-2.5 border-b border-[#3D3D3D]">
            <div class="flex items-center gap-2 sm:gap-3">
              <div class="flex gap-1.5 sm:gap-2" aria-hidden="true">
                <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#E95420]"></div>
                <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#F5C211]"></div>
                <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#0D942C]"></div>
              </div>
              <span class="text-gray-300 font-mono text-xs sm:text-sm ml-1 sm:ml-2 tracking-wide">portfolio-projects.sh</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-gray-500 text-[10px] font-mono hidden sm:block">~/dominid/projects/</span>
            </div>
          </div>
        </div>

        <!-- Terminal Content -->
        <div class="bg-[#1A1A24] border-x border-b border-[#3D3D3D] rounded-b-xl p-5 sm:p-8 font-mono" data-reveal-section>
          <div class="text-green-400 mb-6 sm:mb-8 text-sm sm:text-base flex items-center flex-wrap gap-x-1" data-cmd data-cmd-loading="> loading projects...">
            <span class="text-[#E95420]">dominid@portfolio</span>
            <span class="text-gray-500">:</span>
            <span class="text-yellow-400">~/projects</span>
            <span class="text-gray-500">$</span>
            <span class="text-white">ls</span>
            <span class="text-cyan-400">-la</span>
            <span class="text-purple-400">--backend</span>
          </div>
          <div class="text-center mb-6 sm:mb-8" data-reveal data-reveal-head>
            <h1 class="text-3xl sm:text-4xl md:text-6xl font-bold text-white mb-3 sm:mb-4 font-italiana">
              # Proyectos
            </h1>
            <p class="text-base sm:text-lg text-gray-300 px-2">
              <span class="text-green-400">//</span> Sistemas backend, APIs REST y aplicaciones empresariales
            </p>
          </div>
        </div>

        <!-- Barra de filtros -->
        <div class="bg-[#1A1A24] px-4 sm:px-6 pt-8 pb-2">
          <div class="max-w-7xl mx-auto">
            <div class="bg-[#2C2C2C]/80 rounded-xl p-3 sm:p-4 border border-[#3D3D3D]">
              <div class="flex flex-wrap items-center gap-2 font-mono" role="tablist" aria-label="Filtrar proyectos por categoría">
                <span class="text-gray-500 text-xs mr-1 hidden sm:inline-flex items-center" aria-hidden="true">
                  <span class="text-green-400">$</span>
                  <span class="ml-1.5">filter</span>
                  <span class="text-[#E95420] mx-1">--type</span>
                </span>
                {categories.map((cat) => (
                  <button
                    role="tab"
                    aria-selected={cat === 'all'}
                    class={`filter-tab font-mono text-xs px-3 py-1.5 rounded-lg border transition-all duration-200 ${
                      cat === 'all'
                        ? 'bg-[#E95420] border-[#E95420] text-white shadow-sm'
                        : 'bg-[#1A1A24] border-[#4D4D4D] text-gray-400 hover:border-[#E95420] hover:text-[#E95420] hover:bg-[#2C2C2C]'
                    }`}
                    data-filter={cat}
                  >
                    {filterLabels[cat]}
                    <span class="ml-1.5 text-gray-500 text-[10px] font-mono">
                      {counts[cat] ?? 0}
                    </span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- PROYECTOS -->
        <div class="bg-[#1A1A24] px-4 sm:px-6 pb-4 pt-8 sm:pb-6">
          <div class="max-w-7xl mx-auto space-y-12" id="projects-list" role="tabpanel">

            {projects.map((project, index) => {
              const colors = colorMap[project.color];
              const hasImages = project.images.length > 0;
              const arch = project.architecture;

              return (
                <>
                  {index === othersStartIndex && (
                    <div id="others-heading" class="flex items-center gap-3 pt-4">
                      <span class="text-gray-400 font-mono text-xs"># otros proyectos</span>
                      <div class="h-px flex-1 bg-[#3D3D3D]" aria-hidden="true"></div>
                    </div>
                  )}

                  <div
                    class={`project-card bg-gray-800/90 backdrop-blur-sm rounded-2xl p-4 sm:p-6 lg:p-8 border border-gray-600 hover:border-gray-400 transition-all duration-300`}
                    data-category={project.category}
                    data-reveal
                    style={`--reveal-delay: ${Math.min(index, 3) * 70}ms`}
                  >
                    <div class={`gap-6 sm:gap-8 ${hasImages ? `grid lg:grid-cols-2 items-center ${index % 2 === 0 ? '' : 'lg:grid-flow-dense'}` : ''}`}>

                      <!-- Info -->
                      <div class={`space-y-4 sm:space-y-6 ${hasImages && index % 2 !== 0 ? 'lg:order-2' : ''}`}>
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                          <span class={`w-2 h-2 sm:w-3 sm:h-3 ${colors.dot} rounded-full animate-pulse`} aria-hidden="true"></span>
                          <h2 class="text-lg sm:text-xl lg:text-2xl font-bold text-white font-mono">{project.file}</h2>
                          <span class={`ml-auto text-[10px] font-mono px-2.5 py-0.5 rounded-full border ${colors.border} ${colors.text} uppercase tracking-wider font-semibold`}>
                            {project.category}
                          </span>
                        </div>

                        <div class="space-y-4 sm:space-y-5">
                          <div class="bg-gray-800/80 rounded-xl p-3.5 sm:p-4 border border-gray-700/50">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                              <p class="text-gray-300 text-xs sm:text-sm font-mono"><span class={colors.text}>CLIENT:</span> {project.client}</p>
                              {project.role && <p class="text-gray-300 text-xs sm:text-sm font-mono"><span class="text-green-400">ROLE:</span> {project.role}</p>}
                              <p class="text-gray-300 text-xs sm:text-sm font-mono"><span class="text-yellow-400">DATE:</span> {project.date}</p>
                            </div>
                          </div>

                          <p class="text-gray-300 leading-relaxed text-sm sm:text-base">{project.description}</p>

                          {arch && arch.length > 0 && (
                            <div class="bg-gray-900/60 rounded-xl p-4 border border-gray-700/50">
                              <p class={`text-xs font-mono ${colors.text} mb-3`}>// arquitectura</p>
                              <div class="font-mono text-xs sm:text-sm text-gray-300 space-y-1 max-w-md" role="img" aria-label={`Diagrama de arquitectura: ${arch.join(' descendiendo a ')}`}>
                                {arch.map((layer, i) => (
                                  <div class="space-y-1">
                                    <div class={`bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 ${i === arch.length - 1 ? 'text-cyan-400' : ''}`}>
                                      {layer}
                                    </div>
                                    {i < arch.length - 1 && (
                                      <div class="text-gray-600 text-center leading-none" aria-hidden="true">↓</div>
                                    )}
                                  </div>
                                ))}
                              </div>
                            </div>
                          )}

                          {project.highlights && project.highlights.length > 0 && (
                            <div class="bg-gray-900/50 rounded-xl p-4 border border-gray-700/30">
                              <p class={`text-xs font-mono ${colors.text} mb-2`}>// mi participación</p>
                              <ul class="space-y-1.5">
                                {project.highlights.map((h) => (
                                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-gray-300">
                                    <span class={`${colors.text} mt-0.5 flex-shrink-0 text-lg leading-none`} aria-hidden="true">▸</span>
                                    <span>{h}</span>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          )}

                          <div class="flex flex-wrap gap-1.5 sm:gap-2">
                            {project.technologies.map((tech) => (
                              <span class={`${techBg} text-white px-2.5 sm:px-3 py-1 rounded-full text-xs sm:text-sm transition-all hover:scale-105 hover:border-gray-300`}>{tech}</span>
                            ))}
                          </div>

                          <div class="flex flex-col sm:flex-row gap-2 sm:gap-3 flex-wrap">
                            {project.links.live         && <a href={project.links.live}          target="_blank" rel="noopener noreferrer" class={`${btn} hover:scale-105 hover:shadow-lg`}><span>./ver-proyecto</span><span aria-hidden="true">→</span></a>}
                            {project.links.social       && <a href={project.links.social}         target="_blank" rel="noopener noreferrer" class={`${btn} hover:scale-105 hover:shadow-lg`}><span>./social</span></a>}
                            {project.links.github       && <a href={project.links.github}         target="_blank" rel="noopener noreferrer" class={`${btn} hover:scale-105 hover:shadow-lg`}><span>./github</span><span set:html={githubSvg}></span></a>}
                            {project.links.githubBackend && <a href={project.links.githubBackend} target="_blank" rel="noopener noreferrer" class={`${btn} hover:scale-105 hover:shadow-lg`}><span>./github-backend</span><span set:html={githubSvg}></span></a>}
                            {project.links.githubRaspberry && <a href={project.links.githubRaspberry} target="_blank" rel="noopener noreferrer" class={`${btn} hover:scale-105 hover:shadow-lg`}><span>./github-raspberry</span><span set:html={githubSvg}></span></a>}
                          </div>
                        </div>
                      </div>

                      <!-- Carousel -->
                      {hasImages && (
                        <div class={`relative ${index % 2 === 0 ? 'lg:order-2 order-first' : 'lg:order-1 order-first'}`}>
                          <div class="aspect-video rounded-xl overflow-hidden border border-gray-600 bg-gray-900 shadow-lg shadow-black/30 group/img">
                            <div class="relative w-full h-full">
                              <div id={`carousel-${project.id}`} class="flex transition-transform duration-500 w-full h-full">
                                {project.images.map((img) => (
                                  <img src={img} alt={`Captura de pantalla de ${project.name}`} class="w-full h-full flex-shrink-0 object-cover bg-gray-900 group-hover/img:scale-105 transition-transform duration-700" loading="lazy" decoding="async" width="800" height="450" />
                                ))}
                              </div>
                              <div class="absolute inset-0 bg-gradient-to-t from-gray-900/40 to-transparent pointer-events-none"></div>
                              {project.images.length > 1 && (
                                <>
                                  <button class="carousel-btn-prev absolute left-1 sm:left-2 top-1/2 -translate-y-1/2 bg-gray-800/80 hover:bg-gray-700 text-white p-1.5 sm:p-2.5 rounded-full transition-all z-10 hover:scale-110 hover:shadow-lg" data-carousel={`carousel-${project.id}`} aria-label={`Imagen anterior de ${project.name}`}>‹</button>
                                  <button class="carousel-btn-next absolute right-1 sm:right-2 top-1/2 -translate-y-1/2 bg-gray-800/80 hover:bg-gray-700 text-white p-1.5 sm:p-2.5 rounded-full transition-all z-10 hover:scale-110 hover:shadow-lg" data-carousel={`carousel-${project.id}`} aria-label={`Siguiente imagen de ${project.name}`}>›</button>
                                </>
                              )}
                            </div>
                          </div>
                        </div>
                      )}

                    </div>
                  </div>
                </>
              );
            })}

            <div id="no-results" class="hidden text-center py-16 font-mono">
              <div class="bg-gray-800/50 rounded-xl border border-gray-700/50 p-8 inline-block">
                <div class="text-4xl mb-3 opacity-40" aria-hidden="true">⚡</div>
                <p class="text-gray-400 text-sm">
                  <span class="text-red-400 font-semibold">ERROR:</span> no projects found for this filter
                </p>
                <p class="text-gray-600 text-xs mt-2">// intenta con otro tipo o selecciona "all"</p>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </main>
</BaseLayout>

<script>
  function initCarousel(/** @type {HTMLElement} */ carousel, /** @type {HTMLElement | null} */ prevBtn, /** @type {HTMLElement | null} */ nextBtn, /** @type {NodeListOf<HTMLElement> | null} */ dots) {
    let currentIndex = 0;
    const slides = carousel.children.length;
    if (slides <= 1) return;

    const update = () => {
      carousel.style.transform = `translateX(-${currentIndex * 100}%)`;
      if (dots) {
        dots.forEach((/** @type {HTMLElement} */ d, /** @type {number} */ i) => {
          d.classList.toggle('bg-white', i === currentIndex);
          d.classList.toggle('bg-white/40', i !== currentIndex);
        });
      }
    };

    prevBtn?.addEventListener('click', () => { currentIndex = (currentIndex - 1 + slides) % slides; update(); });
    nextBtn?.addEventListener('click', () => { currentIndex = (currentIndex + 1) % slides; update(); });
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[id^="carousel-"]').forEach(carousel => {
      const id = carousel.id;
      const el = /** @type {HTMLElement} */ (carousel);
      initCarousel(
        el,
        document.querySelector(`[data-carousel="${id}"].carousel-btn-prev`),
        document.querySelector(`[data-carousel="${id}"].carousel-btn-next`),
      );
    });

    const filterTabs = document.querySelectorAll('.filter-tab');
    const projectCards = document.querySelectorAll('.project-card');
    const noResults = /** @type {HTMLElement} */ (document.getElementById('no-results'));
    const othersHeading = /** @type {HTMLElement} */ (document.getElementById('others-heading'));

    const ACTIVE_CLASSES = ['bg-[#E95420]', 'border-[#E95420]', 'text-white'];
    const INACTIVE_CLASSES = ['bg-[#1A1A24]', 'border-[#4D4D4D]', 'text-gray-400'];

    filterTabs.forEach(tab => {
      const tb = /** @type {HTMLElement} */ (tab);
      tb.addEventListener('click', () => {
        filterTabs.forEach(t => {
          const el = /** @type {HTMLElement} */ (t);
          el.classList.remove(...ACTIVE_CLASSES);
          el.classList.add(...INACTIVE_CLASSES);
          el.setAttribute('aria-selected', 'false');
        });
        tb.classList.remove(...INACTIVE_CLASSES);
        tb.classList.add(...ACTIVE_CLASSES);
        tb.setAttribute('aria-selected', 'true');

        const cat = tb.dataset.filter ?? 'all';

        let visible = 0;
        projectCards.forEach(card => {
          const c = /** @type {HTMLElement} */ (card);
          const match = cat === 'all' || c.dataset.category === cat;
          c.style.display = match ? '' : 'none';
          if (match) visible++;
        });

        noResults.classList.toggle('hidden', visible > 0);
        if (othersHeading) othersHeading.style.display = cat === 'all' ? '' : 'none';
      });
    });
  });
</script>
