<!-- ══ MODAL VIDEO DEMO ══════════════════════════════════════════════════════ -->
<div id="demo-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4">
  <div class="bg-[#2C2C2C] rounded-2xl border border-[#4D4D4D] w-full max-w-4xl shadow-2xl">
    <div class="flex items-center justify-between px-5 py-4 border-b border-[#3D3D3D]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 bg-[#E95420] rounded-full animate-pulse"></span>
        <span id="demo-modal-title" class="text-white font-mono text-sm sm:text-base font-semibold"></span>
      </div>
      <button id="demo-modal-close" class="text-gray-400 hover:text-white transition-colors text-2xl leading-none">&times;</button>
    </div>
    <div class="p-4 sm:p-6">
      <video id="demo-video" controls class="w-full rounded-xl bg-black" style="max-height: 65vh;">
        <source id="demo-video-src" src="" type="video/mp4" />
        Tu navegador no soporta el elemento de video.
      </video>
    </div>
  </div>
</div>

<script>
  /**
   * @param {HTMLElement} carousel
   * @param {HTMLElement | null} prevBtn
   * @param {HTMLElement | null} nextBtn
   * @param {NodeListOf<HTMLElement> | null} [dots]
   */
  function initCarousel(carousel, prevBtn, nextBtn, dots) {
    let currentIndex = 0;
    const slides = carousel.children.length;
    if (slides <= 1) return;

    const update = () => {
      carousel.style.transform = `translateX(-${currentIndex * 100}%)`;
      if (dots) {
        dots.forEach((/** @type {HTMLElement} */ d, /** @type {number} */ i) => {
          d.classList.toggle('bg-white', i === currentIndex);
          d.classList.toggle('bg-white/40', i !== currentIndex);
        });
      }
    };

    prevBtn?.addEventListener('click', () => { currentIndex = (currentIndex - 1 + slides) % slides; update(); });
    nextBtn?.addEventListener('click', () => { currentIndex = (currentIndex + 1) % slides; update(); });
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[id^="carousel-"]').forEach(carousel => {
      const id = carousel.id;
      const el = /** @type {HTMLElement} */ (carousel);
      initCarousel(
        el,
        document.querySelector(`[data-carousel="${id}"].carousel-btn-prev`),
        document.querySelector(`[data-carousel="${id}"].carousel-btn-next`),
      );
    });

    document.querySelectorAll('[id^="ac-carousel-"]').forEach(carousel => {
      const id = carousel.id;
      const el = /** @type {HTMLElement} */ (carousel);
      initCarousel(
        el,
        document.querySelector(`[data-ac-carousel="${id}"].ac-carousel-prev`),
        document.querySelector(`[data-ac-carousel="${id}"].ac-carousel-next`),
        document.querySelectorAll(`[data-ac-dot="${id}"]`),
      );
    });

    const modal = /** @type {HTMLElement} */ (document.getElementById('demo-modal'));
    const video = /** @type {HTMLVideoElement} */ (document.getElementById('demo-video'));
    const videoSrc = /** @type {HTMLSourceElement} */ (document.getElementById('demo-video-src'));
    const modalTitle = /** @type {HTMLElement} */ (document.getElementById('demo-modal-title'));
    const closeBtn = /** @type {HTMLElement} */ (document.getElementById('demo-modal-close'));

    /** @param {string} src @param {string} title */
    const openModal = (src, title) => {
      videoSrc.src = src; video.load(); modalTitle.textContent = title;
      modal.classList.remove('hidden'); modal.classList.add('flex');
    };
    const closeModal = () => {
      video.pause(); videoSrc.src = '';
      modal.classList.add('hidden'); modal.classList.remove('flex');
    };

    document.querySelectorAll('.demo-btn').forEach(btn => {
      const el = /** @type {HTMLElement} */ (btn);
      el.addEventListener('click', () => openModal(el.dataset.demo ?? '', el.dataset.demoTitle ?? 'Demo'));
    });
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (/** @type {MouseEvent} */ e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (/** @type {KeyboardEvent} */ e) => { if (e.key === 'Escape') closeModal(); });

    const filterTabs = document.querySelectorAll('.filter-tab');
    const projectCards = document.querySelectorAll('.project-card');
    const noResults = /** @type {HTMLElement} */ (document.getElementById('no-results'));
    const academicSection = /** @type {HTMLElement} */ (document.getElementById('academic-section'));

    const ACTIVE_CLASSES = ['bg-[#E95420]', 'border-[#E95420]', 'text-white'];
    const INACTIVE_CLASSES = ['bg-[#1A1A24]', 'border-[#4D4D4D]', 'text-gray-400'];

    filterTabs.forEach(tab => {
      const tb = /** @type {HTMLElement} */ (tab);
      tb.addEventListener('click', () => {
        filterTabs.forEach(t => {
          const el = /** @type {HTMLElement} */ (t);
          el.classList.remove(...ACTIVE_CLASSES);
          el.classList.add(...INACTIVE_CLASSES);
        });
        tb.classList.remove(...INACTIVE_CLASSES);
        tb.classList.add(...ACTIVE_CLASSES);

        const cat = tb.dataset.filter ?? 'all';

        let visible = 0;
        projectCards.forEach(card => {
          const c = /** @type {HTMLElement} */ (card);
          const match = cat === 'all' || c.dataset.category === cat;
          c.style.display = match ? '' : 'none';
          if (match) visible++;
        });

        noResults.classList.toggle('hidden', visible > 0);
        academicSection.style.display = cat === 'all' ? '' : 'none';
      });
    });
  });
</script>

