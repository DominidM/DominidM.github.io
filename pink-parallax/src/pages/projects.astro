const getTechColor = (tech: string): string => {
  const t = tech.toLowerCase();
  if (t.includes('java') && !t.includes('javascript') && !t.includes('javamail')) return 'orange';
  const rule = techColorRules.find(([kw]) => t.includes(kw));
  return rule ? rule[1] : 'gray';
};

