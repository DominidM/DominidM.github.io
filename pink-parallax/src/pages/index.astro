---
import BaseLayout from "../layouts/BaseLayout.astro";
import Stack from "../components/common/Stack.astro";
import ExperienceSection from "../components/common/ExperienceSection.astro";
import FeaturedProjects from "../components/common/FeaturedProjects.astro";
import EventsCarousel from "../components/common/EventsCarousel.astro";
import { profile } from "../data/profile";
---

<BaseLayout>
  <!-- HERO -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Imagen de fondo -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://res.cloudinary.com/dxuk9bogw/image/upload/v1778606651/Dise%C3%B1o_sin_t%C3%ADtulo_7_yjor13.png"
        alt=""
        class="w-full h-full object-cover object-[60%_center]"
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <!-- Overlay con degradado -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 to-black/70" aria-hidden="true"></div>

    <!-- Contenido -->
    <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-6xl mx-auto w-full py-20">
      <p class="font-display text-base sm:text-lg md:text-xl font-light mb-3 md:mb-4 opacity-90 hero-in" style="--hero-delay: 0ms">
        Hola, mi nombre es
      </p>

      <h1 class="font-body text-3xl sm:text-4xl md:text-6xl xl:text-7xl font-bold mb-3 md:mb-4 tracking-tight hero-in" style="--hero-delay: 60ms">
        <span class="font-italiana">{profile.fullName}</span>
      </h1>

      <h2 class="text-lg sm:text-xl md:text-3xl font-light mb-3 md:mb-4 text-gray-100 hero-in" style="--hero-delay: 150ms">
        {profile.role}
      </h2>

      <p class="font-mono text-sm sm:text-base md:text-lg text-[#E95420] mb-6 md:mb-8 tracking-wide hero-in" style="--hero-delay: 230ms">
        {profile.mainStack.join(' · ')}
      </p>

      <p class="max-w-2xl mx-auto text-sm sm:text-base text-gray-300 mb-8 md:mb-10 leading-relaxed hero-in" style="--hero-delay: 300ms">
        Desarrollador Backend y estudiante de {profile.career}, con experiencia en Java, Spring Boot, NestJS y desarrollo de sistemas empresariales.
      </p>

      <!-- CTAs principales -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center mb-6 md:mb-8 hero-in" style="--hero-delay: 380ms">
        <a
          href="/projects"
          class="px-6 py-3 rounded-lg bg-[#E95420] hover:bg-[#E95420]/90 text-white font-mono text-sm font-medium transition-all hover:scale-105 hover:shadow-lg hover:shadow-[#E95420]/20"
        >
          Ver proyectos
        </a>
        <a
          href={profile.cvUrl}
          download={profile.cvFile}
          class="px-6 py-3 rounded-lg bg-white hover:bg-gray-100 text-[#1A1A24] font-mono text-sm font-bold transition-all hover:scale-105 hover:shadow-lg"
        >
          ↓ Descargar CV
        </a>
      </div>

      <!-- CTAs secundarios -->
      <nav aria-label="Redes" class="flex justify-center gap-6 text-sm hero-in" style="--hero-delay: 460ms">
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-white transition-colors"
        >
          GitHub
        </a>
        <span class="text-gray-600" aria-hidden="true">·</span>
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-white transition-colors"
        >
          LinkedIn
        </a>
      </nav>
    </div>
  </section>

  <!-- STACK -->
  <Stack />

  <!-- EXPERIENCIA (antes de proyectos) -->
  <ExperienceSection />

  <!-- PROYECTOS DESTACADOS -->
  <FeaturedProjects />

  <div class="bg-[#1A1A24]">
    <EventsCarousel />
  </div>
</BaseLayout>
